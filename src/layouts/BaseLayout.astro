---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "https://commons.wikimedia.org/wiki/Special:FilePath/BMW%20E46%20sedan.jpg",
  type = "website",
  publishedTime,
  section,
  tags = [],
  jsonLd,
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const canonical = Astro.url.href;
const rssUrl = new URL(withBase("rss.xml"), Astro.site).toString();
const socialImage = image.startsWith("http") ? image : new URL(withBase(image), Astro.site).toString();
const siteName = "El Garaje de Hompa";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="El Garaje de Hompa" href={rssUrl} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="stylesheet" href={withBase("styles.css")} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {section ? <meta property="article:section" content={section} /> : null}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
  </head>
  <body>
    <div class="scroll-meter" aria-hidden="true"></div>

    <header class="site-header" data-animate>
      <a class="brand" href={base} aria-label="El Garaje de Hompa inicio">
        <span class="brand-mark">GH</span>
        <span>El Garaje de Hompa</span>
      </a>
      <nav class="main-nav" aria-label="Secciones principales">
        <a href={`${base}#hoy`}>Hoy</a>
        <a href={`${base}archivo/`}>Archivo</a>
        <a href={`${base}#guias`}>Guias</a>
        <a href={`${base}#newsletter`}>Newsletter</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <p>El Garaje de Hompa</p>
      <p>Revista diaria de coches con opinion, datos y cultura de compra.</p>
    </footer>

    <script src={withBase("script.js")} is:inline></script>
  </body>
</html>
