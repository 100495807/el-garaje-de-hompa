---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("articulos", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categories = [...new Set(articles.map((article) => article.data.category))].sort();
const tags = [...new Set(articles.flatMap((article) => article.data.tags))].sort();
const normalize = (value: string) =>
  value
    .toLocaleLowerCase("es")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
const archiveUrl = new URL(`${base}archivo/`, Astro.site).toString();
const archiveJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Archivo | El Garaje de Hompa",
  url: archiveUrl,
  inLanguage: "es-ES",
  description: "Archivo de articulos publicados en El Garaje de Hompa.",
  hasPart: articles.map((article) => ({
    "@type": "Article",
    headline: article.data.title,
    url: new URL(`${base}articulos/${article.id}/`, Astro.site).toString(),
    datePublished: article.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout
  title="Archivo | El Garaje de Hompa"
  description="Archivo de articulos publicados en El Garaje de Hompa."
  image="https://images.unsplash.com/photo-1525609004556-c46c7d6cf023?auto=format&fit=crop&w=2200&q=84"
  jsonLd={archiveJsonLd}
>
  <main>
    <section class="archive-hero">
      <div class="archive-hero-content">
        <p class="issue-label" data-animate>Archivo</p>
        <h1 data-animate>Todos los coches que han pasado por el garaje.</h1>
        <p data-animate>
          Analisis, guias de compra y opiniones publicadas. La idea es que este archivo acabe siendo una
          biblioteca viva para consultar antes de comprar, discutir o enamorarse de un coche.
        </p>
      </div>
    </section>

    <section class="section archive-list-section" data-archive>
      <div class="archive-tools" data-animate>
        <div class="archive-search">
          <label for="archive-search">Buscar coche, marca o tema</label>
          <input id="archive-search" type="search" placeholder="MX-5, BMW, roadster, usados..." data-archive-search />
        </div>

        <div class="archive-filter-group" aria-label="Filtrar por categoria">
          <span>Categoria</span>
          <div class="archive-chips">
            <button class="archive-chip is-active" type="button" data-filter-type="category" data-filter-value="all">
              Todo
            </button>
            {categories.map((category) => (
              <button class="archive-chip" type="button" data-filter-type="category" data-filter-value={normalize(category)}>
                {category}
              </button>
            ))}
          </div>
        </div>

        <div class="archive-filter-group" aria-label="Filtrar por etiqueta">
          <span>Marca y tema</span>
          <div class="archive-chips">
            <button class="archive-chip is-active" type="button" data-filter-type="tag" data-filter-value="all">
              Todo
            </button>
            {tags.map((tag) => (
              <button class="archive-chip" type="button" data-filter-type="tag" data-filter-value={normalize(tag)}>
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="archive-results-bar" data-animate>
        <p><strong data-archive-count>{articles.length}</strong> articulos encontrados</p>
        <button type="button" data-archive-reset>Limpiar filtros</button>
      </div>

      <div class="article-cards archive-list">
        {
          articles.map((article) => {
            const searchable = normalize(
              [article.data.title, article.data.description, article.data.car, article.data.category, ...article.data.tags].join(" ")
            );
            const category = normalize(article.data.category);
            const articleTags = `|${article.data.tags.map((tag) => normalize(tag)).join("|")}|`;

            return (
            <a
              class="article-card article-card-link"
              data-animate
              data-archive-card
              data-search={searchable}
              data-category={category}
              data-tags={articleTags}
              href={`${base}articulos/${article.id}/`}
            >
              <img src={article.data.heroImage} alt={article.data.heroAlt} />
              <div>
                <span>{article.data.category}</span>
                <h3>{article.data.title}</h3>
                <dl class="archive-card-facts">
                  <div>
                    <dt>Coche</dt>
                    <dd>{article.data.car}</dd>
                  </div>
                  <div>
                    <dt>Anios</dt>
                    <dd>{article.data.years}</dd>
                  </div>
                </dl>
                <p>{article.data.description}</p>
                <strong>{article.data.verdict}</strong>
              </div>
            </a>
            );
          })
        }
      </div>
      <p class="archive-empty" data-archive-empty hidden>No hay ningun articulo con esos filtros todavia.</p>
    </section>
  </main>
</BaseLayout>
