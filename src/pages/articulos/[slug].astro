---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articulos", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={`${article.data.title} | El Garaje de Hompa`}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
>
  <main>
    <article class="article-page">
      <header class="article-hero">
        <img src={article.data.heroImage} alt={article.data.heroAlt} />
        <div class="article-hero-shade" aria-hidden="true"></div>
        <div class="article-hero-content">
          <p class="issue-label" data-animate>{article.data.category}</p>
          <h1 data-animate>{article.data.title}</h1>
          <p data-animate>{article.data.description}</p>
        </div>
      </header>

      <section class="article-shell">
        <aside class="article-meta" data-animate aria-label="Datos rapidos">
          <span>Coche</span>
          <strong>{article.data.car}</strong>
          <span>Anios</span>
          <strong>{article.data.years}</strong>
          <span>Veredicto</span>
          <p>{article.data.verdict}</p>
          <div class="article-tags" aria-label="Etiquetas">
            {article.data.tags.map((tag) => <em>{tag}</em>)}
          </div>
        </aside>
        <div class="article-body" data-animate>
          {
            article.data.buyerNotes?.length ? (
              <section class="buying-scan" aria-label="Resumen rapido de compra">
                {article.data.buyerNotes.map((note) => (
                  <article>
                    <span>{note.label}</span>
                    <p>{note.text}</p>
                  </article>
                ))}
              </section>
            ) : null
          }

          <Content />

          {
            article.data.gallery?.length ? (
              <section class="article-gallery" aria-labelledby="gallery-title">
                <div class="gallery-heading">
                  <p class="section-kicker">Mirar antes de opinar</p>
                  <h2 id="gallery-title">El coche, en detalle</h2>
                </div>
                <div class="gallery-grid">
                  {article.data.gallery.map((image, index) => (
                    <figure class={index === 0 ? "gallery-card gallery-card-large" : "gallery-card"}>
                      <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} />
                      <figcaption>
                        <strong>{image.caption}</strong>
                        <a href={image.source} target="_blank" rel="noreferrer">
                          {image.credit}
                        </a>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            ) : null
          }

          {
            article.data.sources?.length ? (
              <section class="article-sources">
                <h2>Fuentes consultadas</h2>
                <ul>
                  {article.data.sources.map((source) => (
                    <li>
                      <a href={source.url} target="_blank" rel="noreferrer">
                        {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ) : null
          }
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
